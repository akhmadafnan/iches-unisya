APP_NAME="ICHES UNISYA 2027"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://iches-unisya.test
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file

# Disabled by default for DB-free CI. Configure only the authorized local schema.
DB_CONNECTION=disabled
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=iches_unisya
DB_USERNAME=
DB_PASSWORD=
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
ICHES_DEMO_MODE=false
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

VITE_APP_NAME="${APP_NAME}"
